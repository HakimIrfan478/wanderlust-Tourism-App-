# Copy this file to `.env` and adjust. Django loads it automatically at
# startup (see the load_dotenv() helper at the top of wanderlust/settings.py).
# Real environment variables take precedence over anything set here.

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# 1 = local SQLite file (zero setup, the default so the project runs anywhere)
# 0 = PostgreSQL using the settings below
USE_SQLITE=1

DB_NAME=wanderlust
DB_USER=wanderlust
DB_PASSWORD=wanderlust
DB_HOST=localhost
DB_PORT=5432

# ---------------------------------------------------------------------------
# CORS (the Expo app calls this API from a different origin)
# ---------------------------------------------------------------------------
CORS_ALLOW_ALL=1
# CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# ---------------------------------------------------------------------------
# Recommender
# ---------------------------------------------------------------------------
# Sentence-transformer used for the semantic condition. Downloaded once to the
# HuggingFace cache on first use, then loaded from disk.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Which model an unqualified request gets: semantic | tfidf
RECOMMENDER_DEFAULT_MODEL=semantic

# 1 = never load the transformer (fast tests, or machines without torch).
# The TF-IDF baseline keeps working either way.
DISABLE_SEMANTIC_MODEL=0

# 1 = load the transformer in the background at server startup, so the first
# request does not wait ~10s for it and time out.
RECOMMENDER_WARMUP=1

# 1 = load the transformer from the local cache only, never hit the network.
HF_OFFLINE_ONLY=0

# Where `manage.py run_evaluation` writes results.json / results.csv
# EVALUATION_OUTPUT_DIR=evaluation_results

# ---------------------------------------------------------------------------
# External APIs (both defaults are free and need no key)
# ---------------------------------------------------------------------------
EXTERNAL_API_TIMEOUT=10
WEATHER_CACHE_SECONDS=1800
COUNTRY_CACHE_SECONDS=86400

# Weather is Open-Meteo, which is still keyless.
#
# Country facts: REST Countries deprecated its keyless v3.1 API and its
# replacement v5 requires a key, so the keyless countries.dev is the default.
#   auto          -> restcountries if a key is set below, else countries.dev
#   countries.dev -> always the keyless provider
#   restcountries -> always REST Countries v5 (needs RESTCOUNTRIES_API_KEY)
COUNTRY_API_PROVIDER=auto
RESTCOUNTRIES_API_KEY=
